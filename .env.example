PORT=4000

# Optional: enables OpenAI embeddings. Resume analysis itself currently uses local heuristics.
OPENAI_API_KEY=

# Disk-spooled upload limit; values are constrained to 1-100 MB (default: 50).
RESUME_MAX_FILE_SIZE_MB=50

# Page limit protects PDF rendering/OCR resources (default: 100, maximum: 200).
RESUME_MAX_PAGES=100

# Development override only; production builds always use the same-origin /api path.
VITE_API_BASE_URL=/api
